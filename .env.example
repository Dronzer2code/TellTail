# ---------------------------------------------------------------------------
# TELLTAIL environment
# Copy to .env and fill in.  .env is gitignored; .env.example is not.
# ---------------------------------------------------------------------------

# --- Snowflake -------------------------------------------------------------
# ACCOUNT is the locator form, e.g. xy12345.us-west-2 (not the full URL).
SNOWFLAKE_ACCOUNT=xy12345.us-west-2
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=TELLTAIL_WH
SNOWFLAKE_DATABASE=TELLTAIL

# Only 00_account_setup.sql needs ACCOUNTADMIN. run_sql.py will switch to this
# role for that file alone, then drop back to SNOWFLAKE_ROLE.
SNOWFLAKE_ADMIN_ROLE=ACCOUNTADMIN

# --- Cortex ----------------------------------------------------------------
# Model used by AI_COMPLETE / AI_AGG. Keep it in one place so a region that
# lacks a model is a one-line fix, not a grep across ten SQL files.
CORTEX_MODEL=claude-sonnet-4-5

# Hard stop for the AI layer. Trial accounts without a payment method are
# capped at roughly ten credits/day of AI Function usage. The AI task refuses
# to run if it would exceed this many NEW rows in a single batch.
CORTEX_MAX_ROWS_PER_BATCH=25

# --- Solana ----------------------------------------------------------------
# Public devnet works but its faucet is heavily rate-limited; a Helius
# devnet endpoint gives a usable airdrop and higher request limits.
#   https://devnet.helius-rpc.com/?api-key=<your-key>
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=

# Public address recorded in every attestation as the publishing authority.
# This is NOT the signer: signing needs the secret key in SOLANA_KEYPAIR_PATH.
# If you want THIS wallet to be the on-chain fee payer, export its keypair to
# that path (a file — never paste a secret key into a terminal or a chat).
SOLANA_AUTHORITY=
SOLANA_KEYPAIR_PATH=./secrets/devnet.json
# Leave blank: the bridge writes SPL Memo transactions until a program id is set.
TELLTAIL_PROGRAM_ID=
# Poll interval and batch size for the queue drain loop.
BRIDGE_POLL_SECONDS=15
BRIDGE_BATCH_SIZE=5

# --- Austin Animal Center (Socrata) ---------------------------------------
# Optional. Works unauthenticated at lower rate limits, which is fine for a
# one-shot sync.
SOCRATA_APP_TOKEN=

# --- Replay ----------------------------------------------------------------
# 1 = wall clock (one second of dog time per second)
# 60 = one minute of dog time per second, for recording the demo video
REPLAY_SPEED=1
# Salt for SHA2(dog_id || salt). Change it and every published dog_hash changes.
TELLTAIL_HASH_SALT=change-me-before-you-publish-anything
